{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeberg.org/caniko/sonix/schemas/plan-v1.schema.json",
  "title": "GoXLR Nexus reconciliation plan v1",
  "type": "object",
  "required": [
    "schema",
    "producer",
    "readOnly",
    "requiresApply",
    "current",
    "goxlrStatus",
    "operations",
    "diagnostics"
  ],
  "properties": {
    "schema": {"const": "sonix.goxlr.plan/v1"},
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "sonix-goxlr"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "readOnly": {"const": true},
    "requiresApply": {"const": true},
    "current": {
      "type": "object",
      "required": ["defaultSink", "defaultSource"],
      "properties": {
        "defaultSink": {"type": "string", "minLength": 1},
        "defaultSource": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "goxlrStatus": {"enum": ["ready", "fallback"]},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "arguments", "reason"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "target": {"type": ["string", "null"]},
          "arguments": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "obs": {
      "type": "object",
      "required": ["status", "choiceStatus", "sources"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "scene": {"type": ["string", "null"]},
        "choiceStatus": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "deviceId", "action"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "deviceId": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "diagnostic": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
